{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 6am on monday"
  ],
  "ignorePaths": [
    ".github/workflows/*.lock.yml"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "bundler"
      ],
      "groupName": "Ruby dependencies"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
