<svg width="800" height="450" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="eyeGlow" cx="72%" cy="42%" r="18%">
      <stop offset="0%" stop-color="#ff001a"/>
      <stop offset="60%" stop-color="#b30000"/>
      <stop offset="100%" stop-color="#0a0808" />
    </radialGradient>
    <filter id="blurRed">
      <feGaussianBlur stdDeviation="4"/>
    </filter>
    <filter id="glow">
      <feGaussianBlur in="SourceGraphic" stdDeviation="6" result="blur"/>
      <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
    <!-- subtle vignette -->
  </defs>

  <!-- Background: dark rainy night on Ocean Drive -->
  <rect width="800" height="450" fill="#0a0808"/>
  
  <!-- Distant streetlights — warm neon glow -->
  <ellipse cx="130" cy="260" rx="90" ry="12" fill="#1a1400" opacity=".7"/>
  <rect x="125" y="260" width="8" height="190" fill="#1a1400"/>
  
  <!-- Neon sign glow (Art Deco buildings) -->
  <rect x="240" y="30" width="8" height="70" rx="3" fill="#ff6b00" opacity=".85"/>
  <rect x="258" y="15" width="8" height="90" rx="3" fill="#ffcc00" opacity=".85"/>
  <rect x="-15" y="204" width="70" height="10" rx="3" fill="#ff208a60" transform="rotate(-4, -15, 210)"/>
  
  <!-- Neon reflection on wet ground -->
  <rect x="242" y="310" width="76" height="130" rx="0" fill="#ffcc00" opacity=".09"/>
  <rect x="128" y="425" width="50" height="25" fill="#ff6b00" opacity=".12"/>
  
  <!-- Distant rainy silhouettes of Art Deco buildings -->
  <rect x="300" y="230" width="60" height="200" fill="#140e0e" rx="0"/>
  <rect x="365" y="270" width="40" height="160" fill="#120c0c"/>
  <rect x="410" y="215" width="55" height="215" fill="#151010"/>
  
  <!-- The silhouette of La Ceguega — central figure, slightly backlit -->
  <ellipse cx="670" cy="135" rx="28" ry="42" fill="#fafafa" opacity=".92"/>
  <!-- Hair flowing down -->
  <path d="M640 150 Q633 210, 650 265 M670 93 Q670 230, 685 270 M695 150 Q703 220, 688 260" stroke="#fafafa" stroke-width="4" fill="none" opacity=".8"/>
  
  <!-- Body: dress/silhouette from shoulders down -->
  <path d="M642 180 L635 280 Q670 300, 710 280 L700 180 Z" fill="#e8e0d0" opacity=".5"/>
  <line x1="655" y1="280" x2="648" y2="400" stroke="#e8e0d0" stroke-width="3.5" opacity=".6"/>
  <!-- The dragged leg (mare-like) -->
  <path d="M690 280 Q 710,260, 718,240 L 720,241 Q 714,295, 702,395" stroke="#5c3a3a" stroke-width="4" fill="none"/>
  
  <!-- The TERRIFYING one red eye — center of attention -->
  <circle cx="686" cy="125" r="13" fill="#ff001a" filter="url(#blurRed)" opacity=".9"/>
  <ellipse cx="687" cy="125" rx="4.2" ry="9.5" fill="#1a0000"/>
  
  <!-- Right eye — normal (left is red) -->
  <circle cx="655" cy="122" r="3.5" fill="#5c4033"/>
  
  <!-- Crimson aura around the figure (her supernatural glow) -->
  <ellipse cx="672" cy="218" rx="70" ry="120" fill="none" stroke="#ff002a80" stroke-width=".5" opacity=".35"/>

  <!-- Small man — terrified man on beach path left foreground -->
  <rect x="91" y="222" width="6" height="34" rx="2.5" fill="#fafafa" opacity=".55"/>
  <circle cx="94" cy="212" r="7" fill="#fafafa" opacity=".55"/>

  <!-- Rain streaks -->
  <line x1="380" y1="65" x2="372" y2="90" stroke="#ffffff" stroke-width=".4" opacity=".18"/>
  <line x1="430" y1="40" x2="424" y2="68" stroke="#fff" stroke-width=".5" opacity=".14"/>
  <line x1="750" y1="90" x2="743" y2="115" stroke="#fff" stroke-width=".4" opacity=".12"/>
  <line x1="60" y1="85" x2="52" y2="115" stroke="#fff" stroke-width=".5" opacity=".10"/>
  <line x1="520" y1="30" x2="514" y2="55" stroke="#fff" stroke-width=".4" opacity=".12"/>

  <!-- Wet ground reflection -->
  <ellipse cx="400" cy="473" rx="580" ry="60" fill="#1a0e0e" opacity=".5"/>
  
  <!-- Ground line -->
  <rect x="0" y="412" width="800" height="38" fill="#0c0a0a"/>
  <line x1="0" y1="412" x2="800" y2="412" stroke="#1e1616" stroke-width="1.5"/>
  
  <!-- === GOthic border frame === -->
  <rect x="14" y="14" width="772" height="422" rx="5" fill="none" stroke="#0a0808" stroke-width="3"/>
  <rect x="14" y="14" width="772" height="422" rx="5" fill="none" stroke="#ff002a1a" stroke-width="1.5" opacity=".6"/>
  
  <!-- Corner flourishes — gothic iron-frame style -->
  <path d="M18 30 L18 18 L60 18 M740 18 L782 18 L782 60 M782 392 L782 435 L740 435 M60 435 L18 435" stroke="#ff002a3a" stroke-width="2.5" fill="none"/>
  
  <!-- Vertical bars pattern along the right border -->
  <g opacity=".12">
    <line x1="794" y1="60" x2="794" y2="80" stroke="#ffcc00" stroke-width="2"/>
    <line x1="794" y1="85" x2="794" y2="105" stroke="#ffcc00" stroke-width="2"/>
    <line x1="794" y1="115" x2="794" y2="135" stroke="#ffcc00" stroke-width="2"/>
    <line x1="794" y1="145" x2="794" y2="165" stroke="#ffcc00" stroke-width="2"/>
  </g>

  <!-- Title: dramatic crimson text -->
  <text x="398" y="405" text-anchor="middle" fill="#d41a28" font-family="'Georgia', 'Noto Serif JP', serif" font-size="36" filter="url(#glow)">La CEGUAGA</text>
  <!-- Subtitle — smaller, muted -->
  <text x="398" y="435" text-anchor="middle" fill="#7a202a" font-family="'Georgia', serif" font-size="13">—Ocean Drive midnight encounter—</text>
  
  <!-- Scattered red eye icons as subtle motif -->
  <ellipse cx="340" cy="83" rx="5" ry="9" fill="#ff002a" opacity=".18"/>
  <ellipse cx="760" cy="280" rx="4" ry="9" fill="#ff002a" opacity=".14"/>

</svg>
