<svg width="800" height="450" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="800" height="450" fill="#0a0808"/>
  
  <!-- Gothic frame border -->
  <rect x="12" y="12" width="776" height="426" rx="4" fill="none" stroke="#3d001a" stroke-width="2.5"/>
  <rect x="20" y="20" width="760" height="410" rx="3" fill="none" stroke="#2a0012" stroke-width="1" opacity="0.6"/>
  
  <!-- Corner decorations -->
  <path d="M 25 30 L 55 30 L 55 60 M 30 35 L 48 35 M 37 30 L 37 48" fill="none" stroke="#8b0000" stroke-width="1.2"/>
  <path d="M 775 30 L 745 30 L 745 60 M 770 35 L 752 35 M 763 30 L 763 48" fill="none" stroke="#8b0000" stroke-width="1.2"/>
  <path d="M 25 420 L 55 420 L 55 390 M 30 415 L 48 415 M 37 420 L 37 402" fill="none" stroke="#8b0000" stroke-width="1.2"/>
  <path d="M 775 420 L 745 420 L 745 390 M 770 415 L 752 415 M 763 420 L 763 402" fill="none" stroke="#8b0000" stroke-width="1.2"/>
  
  <!-- Scene: frozen river surface -->
  <ellipse cx="400" cy="340" rx="380" ry="100" fill="#0f1418" opacity="0.7"/>
  <path d="M 50 320 Q 200 290, 400 310 T 750 290 L 750 380 Q 600 400, 400 380 T 50 400 Z" fill="#1a2030" opacity="0.4"/>
  
  <!-- Ice cracks -->
  <path d="M 200 320 L 220 350 L 210 370 M 220 350 L 260 360" fill="none" stroke="#4a6080" stroke-width="1" opacity="0.5"/>
  <path d="M 580 330 L 590 355 M 590 355 L 570 380 M 590 355 L 620 365" fill="none" stroke="#4a6080" stroke-width="1" opacity="0.5"/>
  
  <!-- The frozen river scene - a girl shape half in the water/ice -->
  <ellipse cx="400" cy="305" rx="35" ry="50" fill="#1a2535" stroke="#6080a0" stroke-width="1"/>
  
  <!-- Hair flowing down -->
  <path d="M 370 270 Q 340 300, 350 340 Q 370 360, 390 340" fill="#2a1a40" stroke="#6a3a8a" stroke-width="1" opacity="0.8"/>
  <path d="M 430 270 Q 460 290, 455 320 Q 440 345, 420 335" fill="#2a1a40" stroke="#6a3a8a" stroke-width="1" opacity="0.7"/>
  
  <!-- Water ripples emanating from where she was -->
  <ellipse cx="400" cy="355" rx="60" ry="15" fill="none" stroke="#2a5090" stroke-width="1" opacity="0.4"/>
  <ellipse cx="400" cy="355" rx="90" ry="22" fill="none" stroke="#1a3a6a" stroke-width="0.8" opacity="0.3"/>
  
  <!-- Dead flowers scattered in the water (Morana's effigy decoration) -->
  <circle cx="345" cy="345" r="4" fill="#2a0a35" stroke="#4a1a60" stroke-width="0.8" opacity="0.6"/>
  <circle cx="455" cy="350" r="3" fill="#2a0a35" stroke="#4a1a60" stroke-width="0.8" opacity="0.6"/>
  <circle cx="370" cy="365" r="3.5" fill="#1a0a25" stroke="#3a1050" stroke-width="0.8" opacity="0.5"/>
  
  <!-- A rope/chain pulling her down -->
  <path d="M 400 260 Q 395 240, 410 225 L 425 220" fill="none" stroke="#8a7050" stroke-width="2"/>
  
  <!-- Silhouette figure on the bank above -->
  <ellipse cx="640" cy="230" rx="18" ry="20" fill="#1a0a10" stroke="#4a2030" stroke-width="1"/>
  <line x1="640" y1="250" x2="640" y2="295" stroke="#1a0a10" stroke-width="8"/>
  <line x1="630" y1="270" x2="600" y2="290" stroke="#1a0a10" stroke-width="6"/>
  
  <!-- Moon -->
  <circle cx="150" cy="80" r="25" fill="#d4c080" opacity="0.15"/>
  <circle cx="158" cy="76" r="22" fill="#0a0808"/>
  
  <!-- Moon glow -->
  <circle cx="150" cy="80" r="40" fill="none" stroke="#d4c080" stroke-width="0.5" opacity="0.2"/>
  
  <!-- Stars -->
  <circle cx="480" cy="60" r="1" fill="#ffffff" opacity="0.3"/>
  <circle cx="690" cy="70" r="1" fill="#ffffff" opacity="0.25"/>
  <circle cx="320" cy="55" r="0.8" fill="#ffffff" opacity="0.2"/>
  
  <!-- Title text -->
  <text x="400" y="170" text-anchor="middle" font-family="'Crimson Text', serif" font-size="46" fill="#cc2030" letter-spacing="8" stroke="#5a000b" stroke-width="0.5">MORANA</text>
  
  <!-- Subtitle -->
  <text x="400" y="205" text-anchor="middle" font-family="'Crimson Text', serif" font-size="18" fill="#887060" letter-spacing="3">沈められし者たち</text>
  
  <!-- Decorative line under title -->
  <line x1="290" y1="195" x2="510" y2="195" stroke="#8b0000" stroke-width="0.8" opacity="0.6"/>
  <circle cx="400" cy="195" r="3" fill="#cc2030" opacity="0.7"/>
  
  <!-- Bottom atmospheric text -->
  <text x="400" y="438" text-anchor="middle" font-family="'Crimson Text', serif" font-size="14" fill="#5a4030" letter-spacing="2">春を迎えるための、血の代償</text>
  
  <!-- Fog/mist layer -->
  <rect x="200" y="280" width="400" height="30" rx="15" fill="#8a9aaa" opacity="0.06"/>
</svg>
